# API
# Linux/WSL example: sqlite:///absolute/path/to/map-stop/data/map-stop.db
# Windows (scripts/dev-api.ps1 will rewrite if this still points at /workspace):
#   sqlite:///C:/Users/you/map-stop/data/map-stop.db
DATABASE_URL=sqlite:///workspace/map-stop/data/map-stop.db
JWT_SECRET=change-me-to-a-long-random-string
LISTEN_ADDR=0.0.0.0:8080
CORS_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Routing provider: gaode | embedded | opensource
# Auto: if unset and AMAP_WEB_KEY present → gaode, else embedded
ROUTING_PROVIDER=embedded

# 高德开放平台（勿提交真实 Key）
# 申请：https://console.amap.com/dev/key/app
# - Web服务 Key → AMAP_WEB_KEY（路径规划 / 地理编码 / 输入提示）
# - Web端(JS API) Key → AMAP_JS_KEY（前端底图）
# - 安全密钥 → AMAP_SECURITY_JS_CODE（JS API 2.0 推荐）
AMAP_WEB_KEY=
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
